{
  "manifest_version": 3,
  "name": "TruTerms",
  "description": "Know what you're agreeing to.",
  "version": "0.1.0",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*", "https://truterms.onrender.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Open TruTerms"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]
}
